{
	"name": "generic_highlight",
	"title": "Generic Highlight Reel",
	"version": 1,
	"canvas": { "width": 1920, "height": 1080, "fps": 30 },
	"target_duration": 45,
	"min_clip_duration": 1.0,
	"max_clip_duration": 10.0,
	"scoring": { "motion": 0.45, "audio": 0.35, "duration": 0.20 },
